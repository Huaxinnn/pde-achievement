<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.meituan.pde.dao.DiscussionLikeDao">
    <resultMap id="BaseResultMap" type="com.meituan.pde.entity.DiscussionLike">
        <id column="id" property="id"/>
        <result column="post_id" property="postId"/>
        <result column="user_mis" property="userMis"/>
        <result column="deleted_flag" property="deletedFlag"/>
        <result column="add_time" property="addTime" jdbcType="TIMESTAMP"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="findByPostIdAndUserMis" resultMap="BaseResultMap">
        SELECT id, post_id, user_mis, deleted_flag, add_time, create_time, update_time
        FROM stage_discussion_like
        WHERE post_id = #{postId} AND user_mis = #{userMis} AND deleted_flag = 0
    </select>

    <select id="findByPostIdsAndUserMis" resultMap="BaseResultMap">
        SELECT id, post_id, user_mis, deleted_flag, add_time, create_time, update_time
        FROM stage_discussion_like
        WHERE post_id IN
        <foreach collection="postIds" item="pid" open="(" separator="," close=")">
            #{pid}
        </foreach>
        AND user_mis = #{userMis} AND deleted_flag = 0
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO stage_discussion_like (post_id, user_mis)
        VALUES (#{postId}, #{userMis})
    </insert>

    <update id="deleteByPostIdAndUserMis">
        UPDATE stage_discussion_like SET deleted_flag = 1
        WHERE post_id = #{postId} AND user_mis = #{userMis} AND deleted_flag = 0
    </update>
</mapper>
